[Unit]
Description=SOS Relay bounded public-source research crawl
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sos-crawler
Group=sos-crawler
WorkingDirectory=/var/lib/sos-relay-crawler
ExecStart=/usr/bin/python3 /opt/sos-relay/py/belt_road/crawl.py --db /var/lib/sos-relay-crawler/crawl.db run --sources /var/lib/sos-relay-crawler/sources.json --max-documents 100 --max-depth 1 --target-cases 100
StateDirectory=sos-relay-crawler
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sos-relay-crawler
InaccessiblePaths=-/opt/sos-relay/var
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=50%
TasksMax=16
TimeoutStartSec=1800
