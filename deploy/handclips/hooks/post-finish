#!/usr/bin/env python3
"""tusd post-finish hook: move a finished upload from incoming/<id> to clips/<player>/<filename>.
A file that is already there with the same size is kept (the phone may send a clip twice); a different one gets a numeric suffix."""
import json
import os
import re
import sys

ROOT = "/var/handclips"
ev = json.load(sys.stdin).get("Event", {})
up = ev.get("Upload", {})
meta = up.get("MetaData") or {}
name, player = meta.get("filename", ""), meta.get("player", "")
src = (up.get("Storage") or {}).get("Path") or os.path.join(ROOT, "incoming", up.get("ID", ""))
if not (re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,120}", name) and re.fullmatch(r"[A-Za-z0-9_-]{6,64}", player) and os.path.isfile(src)):
    sys.exit(0)
dst_dir = os.path.join(ROOT, "clips", player)
os.makedirs(dst_dir, exist_ok=True)
dst = os.path.join(dst_dir, name)
if os.path.exists(dst):
    if os.path.getsize(dst) == os.path.getsize(src):
        os.remove(src)
        sys.exit(0)
    stem, ext = os.path.splitext(name)
    n = 2
    while os.path.exists(os.path.join(dst_dir, f"{stem}.{n}{ext}")):
        n += 1
    dst = os.path.join(dst_dir, f"{stem}.{n}{ext}")
os.replace(src, dst)
info = src + ".info"
if os.path.exists(info):
    os.replace(info, dst + ".tusinfo")
print("{}")
